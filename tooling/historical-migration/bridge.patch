+//! Detached historical qualification; never linked into the current runtime.
+use super::MigrationOptions;
+use crate::{
+    LixError,
+    changelog::{ChangeId, ChangeRecord},
+    storage_adapter::*,
+};
+use std::collections::BTreeMap;
+use std::ops::Bound;
+
+fn failure(message: impl Into<String>) -> LixError {
+    LixError::new("LIX_BRIDGE_VERIFICATION_FAILED", message)
+}
+fn canonical_record(record: &ChangeRecord) -> Result<Vec<u8>, LixError> {
+    let mut record = record.clone();
+    record.format_version = 0;
+    crate::changelog::encode_change_record(&record)
+}
+fn digest(bytes: &[u8]) -> String {
+    blake3::hash(bytes).to_hex().to_string()
+}
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+async fn entries(
+    read: &(impl StorageAdapterRead + ?Sized),
+    space: StorageSpace,
+) -> Result<Vec<(Vec<u8>, Vec<u8>)>, LixError> {
+    let mut scan = read
+        .begin_scan(
+            space,
+            StorageKeyRange {
+                lower: Bound::Unbounded,
+                upper: Bound::Unbounded,
+            },
+            StorageBeginScanOptions {
+                projection: StorageCoreProjection::FullValue,
+                ..Default::default()
+            },
+        )
+        .await?;
+    let mut output = Vec::new();
+    let mut bytes = 0usize;
+    while let Some(chunk) = scan.next_chunk().await? {
+        for entry in chunk {
+            let StorageProjectedValue::FullValue(value) = entry.value else {
+                return Err(failure("missing scan value"));
+            };
+            bytes = bytes.saturating_add(entry.key.0.len() + value.len());
+            if output.len() >= 250000 || bytes > 512 * 1024 * 1024 {
+                return Err(failure("witness space budget exceeded"));
+            }
+            output.push((entry.key.0.to_vec(), value.to_vec()));
+        }
+    }
+    Ok(output)
+}
+
+/// Records a source-derived retained-history witness before attempting migration.
+/// Full cutover approval additionally requires current-state and next-hop proof.
+pub async fn bridge_qualify<S>(storage: S, report_path: &str) -> Result<serde_json::Value, LixError>
+where
+    S: Storage + Clone + Send + Sync + 'static,
+{
+    let status = super::inspect_lix(&storage).await?;
+    let version = match status {
+        super::MigrationStatus::Required { from_version, .. }
+            if [68, 71].contains(&from_version) =>
+        {
+            from_version
+        }
+        _ => {
+            return Err(failure(format!(
+                "bridge accepts only68/71; found {status:?}"
+            )));
+        }
+    };
+    let adapter = StorageAdapter::new(storage.clone());
+    let read = adapter.begin_read(Default::default()).await?;
+    let options = MigrationOptions::default();
+    let source_branches = crate::branch::BranchHeadControlContext::new()
+        .reader(&read)
+        .scan()
+        .await?
+        .into_iter()
+        .collect::<BTreeMap<_, _>>();
+    let mut expected = BTreeMap::<ChangeId, ChangeRecord>::new();
+    let mut standalone_ids = std::collections::BTreeSet::new();
+    let mut expected_members = Vec::new();
+    let expected_hot;
+    if version == 68 {
+        let (source, retained) = super::v68::preflight_standalone_changelog(
+            &read,
+            options.max_changes,
+            options.max_preflight_bytes,
+        )
+        .await?;
+        let registrations = super::commit_plan::discover_registered_schema_changes(
+            &read,
+            options.max_changes.saturating_sub(source.len()),
+            options.max_preflight_bytes.saturating_sub(retained),
+        )
+        .await?;
+        let mut plan =
+            super::publish::PublicationPlan::bounded(usize::MAX, options.max_preflight_bytes);
+        let standalone =
+            super::standalone_plan::plan_standalone_changes(source, &registrations, &mut plan)?;
+        let authorities = super::commit_plan::plan_commit_authorities(
+            &read,
+            &standalone.rewritten,
+            &standalone.catalog,
+            options
+                .max_changes
+                .saturating_sub(standalone.rewritten.len()),
+            &mut plan,
+        )
+        .await?;
+        standalone_ids.extend(
+            standalone
+                .rewritten
+                .iter()
+                .map(|change| change.record.change_id),
+        );
+        expected_members = authorities.source_members;
+        let mut all_changes = standalone.rewritten.clone();
+        all_changes.extend(authorities.recovered_changes.iter().cloned());
+        super::hot_plan::plan_hot_rows(
+            &read,
+            &all_changes,
+            &standalone.catalog,
+            options.max_changes,
+            &mut plan,
+        )
+        .await?;
+        expected_hot = plan.bridge_values(crate::hot_state::ROW_SPACE);
+        for change in standalone
+            .rewritten
+            .into_iter()
+            .chain(authorities.recovered_changes)
+        {
+            if let Some(previous) = expected.insert(change.record.change_id, change.record.clone())
+            {
+                if previous != change.record {
+                    return Err(failure("source gives conflicting canonical change records"));
+                }
+            }
+        }
+    } else {
+        expected_hot = entries(&read, crate::hot_state::ROW_SPACE).await?;
+        for (key, value) in entries(&read, crate::changelog::CHANGE_SPACE).await? {
+            let id = ChangeId::new(
+                uuid::Uuid::from_slice(&key).map_err(|error| failure(error.to_string()))?,
+            );
+            standalone_ids.insert(id);
+            expected.insert(id, crate::changelog::decode_change_record(&value, id)?);
+        }
+        for commit in crate::tracked_state::scan_commit_state_manifest_commit_ids(&read).await? {
+            let delta = crate::tracked_state::scan_commit_delta_values(&read, commit, &[]).await?;
+            expected_members.push((
+                commit,
+                delta
+                    .iter()
+                    .map(|row| {
+                        let key = row.key_ref();
+                        (
+                            crate::tracked_state::TrackedStateKey {
+                                schema_key: key.schema_key.to_owned(),
+                                file_id: key.file_id.map(str::to_owned),
+                                row_pk: key.row_pk.clone(),
+                            },
+                            row.value().clone(),
+                        )
+                    })
+                    .collect(),
+            ));
+            for row in delta.iter() {
+                let id = row.value().change_id;
+                let record = crate::tracked_state::load_change_record_by_id(&read, id)
+                    .await?
+                    .ok_or_else(|| failure(format!("source change {id} unavailable")))?;
+                expected.insert(id, record);
+            }
+        }
+    }
+    let source_hot_bytes = expected_hot.clone().into_iter().collect::<BTreeMap<_, _>>();
+    let expected_hot = expected_hot
+        .into_iter()
+        .map(|(key, value)| {
+            Ok((
+                key,
+                digest(crate::hot_state::bridge_hot_semantics(&value)?.as_bytes()),
+            ))
+        })
+        .collect::<Result<BTreeMap<_, _>, LixError>>()?;
+    let mut preserved = Vec::new();
+    let mut space_inventory = Vec::new();
+    for &space in crate::storage_spaces::ALL_STORAGE_SPACES {
+        let values = entries(&read, space).await?;
+        space_inventory.push(serde_json::json!({"space":space.name,"entries":values.len()}));
+        if space == crate::changelog::COMMIT_SPACE
+            || space.name.starts_with("binary_cas.")
+            || space.name.contains("receipt")
+            || space.name.contains("upload")
+            || space.name.starts_with("sync.")
+        {
+            preserved.push((
+                space,
+                values
+                    .into_iter()
+                    .map(|(key, value)| (key, digest(&value)))
+                    .collect::<Vec<_>>(),
+            ));
+        }
+    }
+    let expected_records=expected.iter().map(|(id,record)|Ok(serde_json::json!({"id":id.to_string(),"recordDigest":digest(&canonical_record(record)?)}))).collect::<Result<Vec<_>,LixError>>()?;
+    let raw_records=preserved.iter().map(|(space,values)|serde_json::json!({"space":space.name,"records":values.iter().map(|(key,digest)|serde_json::json!({"key":hex(key),"digest":digest})).collect::<Vec<_>>()})).collect::<Vec<_>>();
+    let mut report = serde_json::json!({"historicalRevision":"6e1efebb3953e8e4e5945fd9a9269a69803970c8","fromVersion":version,"targetVersion":74,"sourceInventory":space_inventory,"sourceBranches":source_branches.iter().map(|(id,control)|serde_json::json!({"id":id,"head":control.head_commit_id.to_string(),"trackedGeneration":control.tracked_generation.to_string(),"createdAt":control.created_at.to_string()})).collect::<Vec<_>>(),"expectedChanges":expected_records,"protectedSourceRecords":raw_records,"sourceHotRows":expected_hot.iter().map(|(key,value)|serde_json::json!({"key":hex(key),"digest":value})).collect::<Vec<_>>(),"sourceMembership":expected_members.iter().map(|(commit,members)|serde_json::json!({"commit":commit.to_string(),"digest":digest(format!("{members:?}").as_bytes()),"members":members.len()})).collect::<Vec<_>>(),"retainedHistoryVerified":false,"fullSemanticPreservationVerified":false});
+    std::fs::write(report_path, serde_json::to_vec_pretty(&report).unwrap())
+        .map_err(|error| failure(error.to_string()))?;
+    drop(read);
+    let migration = super::migrate_lix(storage.clone(), options).await?;
+    let read = adapter.begin_read(Default::default()).await?;
+    let mut retain = Vec::new();
+    for id in standalone_ids {
+        let values = PointReadPlan::new(
+            crate::changelog::CHANGE_SPACE,
+            &[StorageKey(bytes::Bytes::copy_from_slice(
+                id.as_uuid().as_bytes(),
+            ))],
+        )
+        .materialize(&read, Default::default())
+        .await?
+        .value;
+        if values.first().is_some_and(Option::is_none) {
+            retain.push((
+                id.as_uuid().as_bytes().to_vec(),
+                crate::changelog::encode_change_record(&expected[&id])?,
+            ));
+        }
+    }
+    let retained_standalone = retain.len();
+    if !retain.is_empty() {
+        let revision = StorageAdapter::<S>::load_mutation_revision_from_read(&read).await?;
+        drop(read);
+        let mut plan = super::publish::PublicationPlan::bounded(
+            options.max_changes,
+            options.max_preflight_bytes,
+        );
+        plan.put_mutable(crate::changelog::CHANGE_SPACE, retain)?;
+        super::publish::publish(
+            &storage,
+            revision,
+            b"tracked-default-branch.v74",
+            b"tracked-default-branch.v74",
+            plan,
+        )
+        .await?;
+    } else {
+        drop(read);
+    }
+    let read = adapter.begin_read(Default::default()).await?;
+    for (id, expected) in &expected {
+        let actual = crate::tracked_state::load_change_record_by_id(&read, *id).await?;
+        let actual = if let Some(actual) = actual {
+            actual
+        } else {
+            let values = PointReadPlan::new(
+                crate::changelog::CHANGE_SPACE,
+                &[StorageKey(bytes::Bytes::copy_from_slice(
+                    id.as_uuid().as_bytes(),
+                ))],
+            )
+            .materialize(&read, Default::default())
+            .await?
+            .value;
+            let Some(Some(StorageProjectedValue::FullValue(value))) = values.first() else {
+                return Err(failure(format!(
+                    "lost retained change {id}; schema={}",
+                    expected.schema_key
+                )));
+            };
+            crate::changelog::decode_change_record(value, *id)?
+        };
+        if canonical_record(&actual)? != canonical_record(expected)? {
+            return Err(failure(format!(
+                "retained change {id} differs: format={} account={} schema={} row_pk={} file={} snapshot={} metadata={} timestamp={} origin={}",
+                actual.format_version != expected.format_version,
+                actual.account_id != expected.account_id,
+                actual.schema_key != expected.schema_key,
+                actual.row_pk != expected.row_pk,
+                actual.file_id != expected.file_id,
+                actual.snapshot != expected.snapshot,
+                actual.metadata != expected.metadata,
+                actual.created_at != expected.created_at,
+                actual.origin_key != expected.origin_key
+            )));
+        }
+    }
+    for (space, source) in preserved {
+        let actual = entries(&read, space)
+            .await?
+            .into_iter()
+            .map(|(key, value)| (key, digest(&value)))
+            .collect::<BTreeMap<_, _>>();
+        for (key, digest) in source {
+            if actual.get(&key) != Some(&digest) {
+                return Err(failure(format!(
+                    "protected source record changed in {}",
+                    space.name
+                )));
+            }
+        }
+    }
+    for (commit, expected) in &expected_members {
+        let delta = crate::tracked_state::scan_commit_delta_values(&read, *commit, &[]).await?;
+        let actual = delta
+            .iter()
+            .map(|row| {
+                let key = row.key_ref();
+                (
+                    crate::tracked_state::TrackedStateKey {
+                        schema_key: key.schema_key.to_owned(),
+                        file_id: key.file_id.map(str::to_owned),
+                        row_pk: key.row_pk.clone(),
+                    },
+                    row.value().clone(),
