+    }
+    let actual_hot_bytes = entries(&read, crate::hot_state::ROW_SPACE)
+        .await?
+        .into_iter()
+        .collect::<BTreeMap<_, _>>();
+    let actual_hot = actual_hot_bytes
+        .clone()
+        .into_iter()
+        .map(|(key, value)| {
+            Ok((
+                key,
+                digest(crate::hot_state::bridge_hot_semantics(&value)?.as_bytes()),
+            ))
+        })
+        .collect::<Result<BTreeMap<_, _>, LixError>>()?;
+    if actual_hot.keys().ne(expected_hot.keys()) {
+        return Err(failure("current row identity set changed"));
+    }
+    let mut amended_rows = Vec::new();
+    for (key, expected) in &expected_hot {
+        if actual_hot.get(key) != Some(expected) {
+            if let Some(after) = actual_hot_bytes.get(key) {
+                if crate::hot_state::bridge_account_schema_amendment(
+                    key,
+                    &source_hot_bytes[key],
+                    after,
+                )? {
+                    amended_rows.push(hex(key));
+                    continue;
+                }
+            }
+            return Err(failure(format!("source current row changed: {}", hex(key))));
+        }
+    }
+    report["verifiedDestinationDigest"] = content_digest(&read).await?.into();
+    report["fullSemanticPreservationVerified"] = true.into();
+    report["branchAncestryVerified"] = true.into();
+    report["schemaAmendmentRows"] = serde_json::json!(amended_rows);
+    report["retainedHistoryVerified"] = true.into();
+    report["currentRowsVerified"] = true.into();
+    report["retainedStandaloneRecords"] = retained_standalone.into();
+    report["commitMembershipVerified"] = true.into();
+    report["toVersion"] = migration.to_version.into();
+    std::fs::write(report_path, serde_json::to_vec_pretty(&report).unwrap())
+        .map_err(|error| failure(error.to_string()))?;
+    Ok(report)
+}
+
+async fn content_digest(read: &(impl StorageAdapterRead + ?Sized)) -> Result<String, LixError> {
+    let mut hasher = blake3::Hasher::new();
+    for &space in crate::storage_spaces::ALL_STORAGE_SPACES {
+        hasher.update(&space.id.0.to_be_bytes());
+        for (key, value) in entries(read, space).await? {
+            hasher.update(&(key.len() as u64).to_be_bytes());
+            hasher.update(&key);
+            hasher.update(&(value.len() as u64).to_be_bytes());
+            hasher.update(&value);
+        }
+    }
+    Ok(hasher.finalize().to_hex().to_string())
+}
+
+/// Rechecks the sealed destination after successful source-derived verification.
+/// This detects later mutation; it is never a substitute for source proof.
+pub async fn bridge_recheck<S: Storage>(
+    storage: S,
+    report: &serde_json::Value,
+) -> Result<(), LixError> {
+    if report["retainedHistoryVerified"] != true
+        || report["branchAncestryVerified"] != true
+        || report["commitMembershipVerified"] != true
+        || report["currentRowsVerified"] != true
+    {
+        return Err(failure("source proof incomplete"));
+    }
+    let adapter = StorageAdapter::new(storage);
+    let read = adapter.begin_read(Default::default()).await?;
+    if report["verifiedDestinationDigest"].as_str() != Some(content_digest(&read).await?.as_str()) {
+        return Err(failure("verified destination changed after source proof"));
+    }
+    Ok(())
+}
