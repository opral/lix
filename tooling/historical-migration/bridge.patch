+        }
+    }
+    let destination_branches = crate::branch::BranchHeadControlContext::new()
+        .reader(&read)
+        .scan()
+        .await?
+        .into_iter()
+        .collect::<BTreeMap<_, _>>();
+    if destination_branches.keys().ne(source_branches.keys()) {
+        return Err(failure("branch identity set changed"));
+    }
+    let mut amendment_heads = std::collections::BTreeSet::new();
+    for (id, before) in &source_branches {
+        let after = &destination_branches[id];
+        if before.created_at != after.created_at
+            || before.tracked_generation != after.tracked_generation
+        {
+            return Err(failure(format!("branch {id} identity/generation changed")));
+        }
+        if before.head_commit_id != after.head_commit_id {
+            let key = StorageKey(bytes::Bytes::copy_from_slice(
+                after.head_commit_id.as_uuid().as_bytes(),
+            ));
+            let result = PointReadPlan::new(crate::changelog::COMMIT_SPACE, &[key])
+                .materialize(&read, Default::default())
+                .await?
+                .value;
+            let Some(Some(StorageProjectedValue::FullValue(value))) = result.first() else {
+                return Err(failure("amendment commit unavailable"));
+            };
+            let commit: crate::changelog::CommitRecord =
+                crate::storage_codec::decode("bridge amendment commit", value)?;
+            if commit.parent_commit_ids != vec![before.head_commit_id] {
+                return Err(failure(format!("branch {id} amendment rewrote ancestry")));
+            }
+            let delta =
+                crate::tracked_state::scan_commit_delta_values(&read, after.head_commit_id, &[])
+                    .await?;
+            if delta.len() != 1
+                || delta.iter().any(|row| {
+                    row.key_ref().schema_key != "lix_registered_schema"
+                        || row.key_ref().row_pk != &crate::row_pk::RowPk::single("lix_account")
+                })
+            {
+                return Err(failure(format!(
+                    "branch {id} amendment contains unexpected user changes"
+                )));
+            }
+            amendment_heads.insert(after.head_commit_id.as_uuid().as_bytes().to_vec());
+        }
+    }
+    let final_commits = entries(&read, crate::changelog::COMMIT_SPACE).await?;
+    let source_commit_keys = report["protectedSourceRecords"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|entry| entry["space"] == crate::changelog::COMMIT_SPACE.name)
+        .unwrap()["records"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|entry| entry["key"].as_str().unwrap().to_owned())
+        .collect::<std::collections::BTreeSet<_>>();
+    if final_commits
+        .iter()
+        .filter(|(key, _)| !source_commit_keys.contains(&hex(key)))
+        .map(|(key, _)| key.clone())
+        .collect::<std::collections::BTreeSet<_>>()
