+/// Detached historical bridge proof: omit derived working-diff acceleration.
+pub(crate) fn bridge_hot_semantics(bytes:&[u8])->Result<String,LixError>{
+ let value=decode_head_value(bytes)?;
+ Ok(format!("{:?}|{:?}|{}|{}|{:?}|{:?}|{:?}|{:?}",value.change_id,value.commit_id,value.untracked,value.deleted,value.created_at,value.updated_at,value.snapshot,value.metadata))
+}
+
+/// The sole logical amendment in the pinned bridge adds profile_uri to lix_account.
+pub(crate) fn bridge_account_schema_amendment(key:&[u8], before:&[u8], after:&[u8])->Result<bool,LixError>{
+ let identity=decode_hot_row_key_for_migration(key)?;
+ if identity.schema_key!="lix_registered_schema" {return Ok(false)}
+ let before=decode_head_value(before)?;let after=decode_head_value(after)?;
+ if before.deleted || after.deleted || before.untracked!=after.untracked || before.metadata!=after.metadata {return Ok(false)}
+ let(Some(before_payload),Some(after_payload))=(before.snapshot,after.snapshot)else{return Ok(false)};
+ let before_row=WasmTypedRow::decode_durable_payload(Arc::from(before_payload),&identity.schema_key,&identity.row_pk)?;
+ let after_row=WasmTypedRow::decode_durable_payload(Arc::from(after_payload),&identity.schema_key,&identity.row_pk)?;
+ if before_row.row.get("schema_key")!=Some(&lix_schema::Value::Text("lix_account".to_owned())) || after_row.row.get("schema_key")!=before_row.row.get("schema_key") {return Ok(false)}
+ let(Some(lix_schema::Value::Jsonb(before_schema)),Some(lix_schema::Value::Jsonb(after_schema)))=(before_row.row.get("value"),after_row.row.get("value"))else{return Ok(false)};
+ let target=crate::schema::seed_schema_definition("lix_account").expect("builtin account schema");
+ if &after_schema.clone().into_value()!=target{return Ok(false)}
+ let source=lix_schema::from_value(before_schema.clone().into_value()).map_err(|error|head_value_error(&error.to_string()))?;
+ let target=lix_schema::from_value(target.clone()).map_err(|error|head_value_error(&error.to_string()))?;
+ Ok(lix_schema::validate_amendment(&source,&target).is_ok())
+}
