+/// Destructive qualification probe. Operator CLI exposes this only for disposable copies.
+#[doc(hidden)]
+pub async fn bridge_negative_check<S: Storage + Clone>(
+    storage: S,
+    report: &serde_json::Value,
+    alter: bool,
+) -> Result<(), LixError> {
+    bridge_recheck(storage.clone(), report).await?;
+    let adapter = StorageAdapter::new(storage.clone());
+    let read = adapter.begin_read(Default::default()).await?;
+    let (key, value) = entries(&read, crate::changelog::CHANGE_SPACE)
+        .await?
+        .into_iter()
+        .find(|(key, value)| {
+            let Ok(uuid) = uuid::Uuid::from_slice(key) else {
+                return false;
+            };
+            crate::changelog::decode_change_record(value, ChangeId::new(uuid))
+                .is_ok_and(|record| record.schema_key == "lix_branch_ref")
+        })
+        .ok_or_else(|| failure("no retained branch ref for negative probe"))?;
+    drop(read);
+    let mut write = storage.begin_write(Default::default()).await?;
+    if alter {
+        let mut value = value;
+        value.push(0);
+        write
+            .put_many(
+                crate::changelog::CHANGE_SPACE,
+                PutBatch {
+                    entries: vec![PutEntry {
+                        key: StorageKey(key.into()),
+                        value: crate::storage::StoredValue {
+                            bytes: value.into(),
+                        },
+                    }],
+                },
+            )
+            .await?;
+    } else {
+        write
+            .delete_many(crate::changelog::CHANGE_SPACE, &[StorageKey(key.into())])
+            .await?;
+    }
+    write.commit().await?;
+    match bridge_recheck(storage, report).await {
+        Err(error) if error.code == "LIX_BRIDGE_VERIFICATION_FAILED" => Ok(()),
+        other => Err(failure(format!(
+            "negative corruption probe was not rejected: {other:?}"
+        ))),
+    }
+}
