+//! Offline qualification only. Argument must be a disposable physical copy.
+use lix_storage_slatedb::SlateDB;
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut arguments = std::env::args().skip(1);
+    let directory = arguments
+        .next()
+        .ok_or("expected disposable physical directory")?;
+    let report_path = arguments.next().ok_or("expected witness report path")?;
+    if arguments.next().as_deref() != Some("--isolated-copy") {
+        return Err("explicit --isolated-copy required".into());
+    }
+    let directory = std::path::PathBuf::from(directory);
+    let root = directory.parent().ok_or("directory needs parent")?;
+    let prefix = directory
+        .file_name()
+        .ok_or("directory needs name")?
+        .to_str()
+        .ok_or("directory is not UTF-8")?;
+    let objects = std::sync::Arc::new(object_store::local::LocalFileSystem::new_with_prefix(root)?);
+    let operation = arguments.next();
+    if operation.as_deref() == Some("--manifest-only") {
+        println!(
+            "{}",
+            serde_json::to_string_pretty(&physical_manifest(&directory)?)?
+        );
+        return Ok(());
+    }
+    let patch_hash = std::env::var("LIX_HISTORICAL_PATCH_SHA256")
+        .map_err(|_| "run through the pinned historical-migration operator script")?;
+    if patch_hash.len() != 64 || !patch_hash.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err("invalid historical patch provenance".into());
+    }
+    let source_objects = physical_manifest(&directory)?;
+    if operation.is_none() {
+        std::fs::write(
+            format!("{report_path}.physical-source.json"),
+            serde_json::to_vec_pretty(&source_objects)?,
+        )?;
+    }
+    let storage = SlateDB::open_object_store_with_options(prefix, objects, Default::default())?;
+    let mut report = if matches!(
+        operation.as_deref(),
+        Some("--verify-only" | "--negative-delete" | "--negative-alter")
+    ) {
+        let report: serde_json::Value = serde_json::from_slice(&std::fs::read(&report_path)?)?;
+        match operation.as_deref() {
+            Some("--negative-delete") => {
+                lix::migration::bridge_negative_check(storage, &report, false).await?
+            }
+            Some("--negative-alter") => {
+                lix::migration::bridge_negative_check(storage, &report, true).await?
+            }
+            _ => lix::migration::bridge_recheck(storage, &report).await?,
+        }
+        report
+    } else {
+        lix::migration::bridge_qualify(storage, &report_path).await?
+    };
+    if operation.is_none() {
+        report["bridgePatchSha256"] = patch_hash.into();
+        report["sourceObjects"] = source_objects;
+        report["verifiedDestinationObjects"] = physical_manifest(&directory)?;
+        std::fs::write(&report_path, serde_json::to_vec_pretty(&report)?)?;
+    }
+    if operation.as_deref() == Some("--verify-only") {
+        report["verifiedDestinationObjects"] = physical_manifest(&directory)?;
+        std::fs::write(&report_path, serde_json::to_vec_pretty(&report)?)?;
+    }
+    println!("{}", serde_json::to_string_pretty(&report)?);
+    Ok(())
+}
+
+fn physical_manifest(
+    root: &std::path::Path,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    fn collect(
+        root: &std::path::Path,
+        dir: &std::path::Path,
+        rows: &mut Vec<serde_json::Value>,
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        for entry in std::fs::read_dir(dir)? {
+            let entry = entry?;
+            let path = entry.path();
+            if entry.file_type()?.is_symlink() {
+                return Err("symlink in physical source".into());
+            }
+            if path.is_dir() {
+                collect(root, &path, rows)?
+            } else if path.is_file() {
+                let mut file = std::fs::File::open(&path)?;
+                let mut hasher = blake3::Hasher::new();
+                let mut buffer = [0u8; 65536];
+                let mut size = 0u64;
+                loop {
+                    let n = std::io::Read::read(&mut file, &mut buffer)?;
+                    if n == 0 {
+                        break;
+                    }
+                    hasher.update(&buffer[..n]);
+                    size += n as u64;
+                }
+                rows.push(serde_json::json!({"key":path.strip_prefix(root)?.to_str().ok_or("invalid path")?,"bytes":size,"blake3":hasher.finalize().to_hex().to_string()}));
+            }
+        }
+        Ok(())
+    }
+    let mut rows = Vec::new();
+    collect(root, root, &mut rows)?;
+    rows.sort_by(|a, b| a["key"].as_str().cmp(&b["key"].as_str()));
+    Ok(serde_json::json!(rows))
+}
