package lix:plugin@1.0.0;

interface host {
  type bytes = list<u8>;

  variant host-error {
    invalid-range,
    limit-exceeded(string),
    rejected(string),
  }

  record record-chunk {
    total-len: u64,
    bytes: bytes,
  }

  /// One immutable host-owned file and plugin-state version.
  resource snapshot {
    file-len: func() -> u64;
    read-file: func(offset: u64, length: u32) -> result<bytes, host-error>;
    read-state: func(
      key: bytes,
      offset: u64,
      max-bytes: u32,
    ) -> result<option<record-chunk>, host-error>;
  }

  /// One bounded, self-describing page of row mutations.
  record row-page {
    payload: bytes,
  }

  resource row-source {
    /// Pull the same universal page envelope accepted by `emit-rows`.
    next-page: func(
      max-bytes: u32,
    ) -> result<option<row-page>, host-error>;
    /// Read an oversized value referenced by the most recent page.
    read-attachment: func(
      ordinal: u32,
      offset: u64,
      length: u32,
    ) -> result<option<bytes>, host-error>;
  }

  /// The sole host-owned atomic output capability. Checkpoints and semantic
  /// pages remain staged until the enclosing guest export succeeds.
  resource transition {
    max-batch-bytes: func() -> u32;
    put-state: func(key: bytes, value: bytes) -> result<_, host-error>;
    delete-state: func(key: bytes) -> result<_, host-error>;
    emit-rows: func(page: row-page) -> result<_, host-error>;
    /// Stages one oversized row snapshot. The returned ordinal is encoded
    /// by the SDK in the next universal row page.
    begin-row-attachment: func(total-length: u64) -> result<u32, host-error>;
    write-row-attachment: func(chunk: bytes) -> result<_, host-error>;
    finish-row-attachment: func() -> result<_, host-error>;
    begin-file-replacement: func(total-length: u64) -> result<_, host-error>;
    write-file-replacement: func(chunk: bytes) -> result<_, host-error>;
    finish-file-replacement: func() -> result<_, host-error>;
  }

  enum conflict-side {
    base,
    a,
    b,
  }

  record conflict-meta {
    ordinal: u32,
    schema-key: string,
    row-pk: list<string>,
    base-len: option<u64>,
    a-len: option<u64>,
    b-len: option<u64>,
  }

  /// A bounded lazy view of canonically ordered semantic conflicts.
  resource conflict-source {
    len: func() -> u32;
    get: func(index: u32) -> result<conflict-meta, host-error>;
    read-value: func(
      index: u32,
      side: conflict-side,
      offset: u64,
      length: u32,
    ) -> result<option<bytes>, host-error>;
  }

  /// Ordered, host-staged conflict results. Replacement snapshots stream in
  /// bounded chunks; a trap or validation failure publishes nothing.
  resource resolution-sink {
    max-batch-bytes: func() -> u32;
    take: func(ordinal: u32, side: conflict-side) -> result<_, host-error>;
    delete: func(ordinal: u32) -> result<_, host-error>;
    begin-replace: func(
      ordinal: u32,
      total-length: u64,
    ) -> result<_, host-error>;
    write-replacement: func(chunk: bytes) -> result<_, host-error>;
    finish-replace: func() -> result<_, host-error>;
  }
}

interface api {
  use host.{bytes, conflict-source, row-source, resolution-sink, snapshot, transition};

  variant plugin-error {
    invalid-input(string),
    limit-exceeded(string),
    internal(string),
  }

  record create-context {
    high: u64,
    low: u32,
  }

  record file-edit {
    offset: u64,
    delete-len: u64,
    insert: bytes,
  }

  record open-request {
    path: string,
    accepted: own<snapshot>,
    creates: create-context,
  }

  record file-changed-request {
    before-path: string,
    after-path: string,
    /// Accepted predecessor bytes plus opaque plugin state. Byte updates do
    /// not expose semantic rows through this snapshot; rows are
    /// transition outputs and host authority. This contract is identical for
    /// warm execution and durable cold restoration.
    before: own<snapshot>,
    edits: list<file-edit>,
    creates: create-context,
  }

  record conflict-update {
    path: string,
    conflicts: own<conflict-source>,
  }

  record rows-changed-request {
    before-path: string,
    before: own<snapshot>,
    changes: own<row-source>,
  }

  record restore-request {
    accepted: option<own<snapshot>>,
    rows: own<row-source>,
  }

  /// Rebuild an evicted actor directly as the successor of a byte transition.
  /// Durable rows provide semantic identity while the accepted blob and
  /// sparse edits provide byte authority.
  record cold-file-changed-request {
    before-path: string,
    after-path: string,
    before: own<snapshot>,
    edits: list<file-edit>,
    rows: own<row-source>,
    creates: create-context,
  }

  /// Every stateful file lifecycle enters through one operation and one
  /// atomic output. The variant makes completeness explicit without growing
  /// the exported ABI for each lifecycle case.
  variant transition-request {
    open(open-request),
    file-changed(file-changed-request),
    rows-changed(rows-changed-request),
    restore(restore-request),
    cold-file-changed(cold-file-changed-request),
  }

  /// All file transitions use one fused guest entry and one borrowed,
  /// host-owned atomic output capability.
  apply: func(
    request: transition-request,
    output: borrow<transition>,
  ) -> result<_, plugin-error>;

  /// Stateless merge resolution: no document hydration and no returned cursor.
  resolve-conflicts: func(
    input: conflict-update,
    output: borrow<resolution-sink>,
  ) -> result<_, plugin-error>;

}

world plugin {
  import host;
  export api;
}
