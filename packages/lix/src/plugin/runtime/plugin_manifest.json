{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "match",
    "entry",
    "schemas"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_glob"],
      "properties": {
        "path_glob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["text", "binary"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefix_excludes"],
              "properties": {
                "prefix_excludes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["byte", "bytes"],
                  "properties": {
                    "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
                    "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
