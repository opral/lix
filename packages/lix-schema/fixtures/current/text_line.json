{
  "$schema": "https://lix.dev/schema-v1.json",
  "key": "text_line",
  "description": "One byte-exact byte-exact text line. Newline bytes remain part of content_base64.",
  "columns": [
    {
      "name": "content_base64",
      "type": "text",
      "nullable": false
    },
    {
      "name": "id",
      "type": "uuid",
      "nullable": false,
      "default_expression": "uuidv7()"
    },
    {
      "name": "order_key",
      "type": "text",
      "nullable": false
    }
  ],
  "primary_key": [
    "id"
  ]
}