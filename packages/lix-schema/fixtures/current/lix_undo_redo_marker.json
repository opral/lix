{
  "$schema": "https://lix.dev/schema-v1.json",
  "key": "lix_undo_redo_marker",
  "description": "Internal tracked marker carrying branch undo/redo cursor state. This schema is intentionally hidden from generated entity SQL surfaces.",
  "columns": [
    {
      "name": "branch_id",
      "type": "uuid",
      "nullable": false
    },
    {
      "name": "kind",
      "type": "text",
      "nullable": false
    },
    {
      "name": "redo_next",
      "type": "uuid",
      "nullable": true
    },
    {
      "name": "redo_top_after",
      "type": "uuid",
      "nullable": true
    },
    {
      "name": "target_commit_id",
      "type": "uuid",
      "nullable": false
    },
    {
      "name": "undo_target_after",
      "type": "uuid",
      "nullable": true
    }
  ],
  "primary_key": [
    "branch_id"
  ]
}