package lix:plugin@3.0.0;

interface host {
  type bytes = list<u8>;

  variant host-error {
    invalid-range,
    limit-exceeded(string),
    rejected(string),
  }

  /// One immutable host-owned file/entity/state version. The guest owns only
  /// a capability and reads the ranges or state pages needed by a transition.
  resource root {
    generation: func() -> string;
    file-len: func() -> u64;
    read-file: func(offset: u64, length: u32) -> result<bytes, host-error>;
    get-entity: func(key: bytes) -> result<option<bytes>, host-error>;
    get-state: func(key: bytes) -> result<option<bytes>, host-error>;
  }

  /// A host-staged copy-on-write successor. File splices are installed before
  /// guest entry; the guest may replace only opaque state pages. Publication
  /// remains atomic and happens only after every emitted semantic page passes
  /// host validation.
  resource transaction {
    put-state: func(key: bytes, value: bytes) -> result<_, host-error>;
    delete-state: func(key: bytes) -> result<_, host-error>;
  }

  record change-page {
    format-version: u16,
    record-count: u32,
    payload: bytes,
  }

  record csv-row-batch {
    row-count: u32,
    payload: bytes,
  }

  /// Host-imported push sink: one top-level export remains entered while the
  /// guest emits bounded pages directly into transaction/storage lowering.
  resource transition-sink {
    emit-changes: func(page: change-page) -> result<_, host-error>;
    emit-csv-rows: func(batch: csv-row-batch) -> result<_, host-error>;
  }
}

interface api {
  use host.{bytes, root, transaction, transition-sink};

  variant plugin-error {
    invalid-input(string),
    limit-exceeded(string),
    internal(string),
  }

  record file-descriptor {
    path: option<string>,
    media-type: option<string>,
  }

  record create-context {
    high: u64,
    low: u32,
  }

  record source-range {
    offset: u64,
    length: u64,
  }

  variant input-bytes {
    inline(bytes),
    after-range(source-range),
  }

  record input-splice {
    offset: u64,
    delete-len: u64,
    insert: input-bytes,
  }

  record open-file-input {
    descriptor: file-descriptor,
    accepted: own<root>,
    successor: own<transaction>,
    creates: create-context,
    max-batch-bytes: u32,
  }

  record file-update {
    before-descriptor: file-descriptor,
    after-descriptor: file-descriptor,
    before: own<root>,
    edits: list<input-splice>,
    successor: own<transaction>,
    creates: create-context,
    max-batch-bytes: u32,
  }

  record transition-summary {
    entity-count: u64,
    batch-count: u32,
    payload-bytes: u64,
  }

  record file-transition {
    successor: own<transaction>,
    summary: transition-summary,
  }

  open-file: func(
    input: open-file-input,
    sink: borrow<transition-sink>,
  ) -> result<file-transition, plugin-error>;

  file-changed: func(
    input: file-update,
    sink: borrow<transition-sink>,
  ) -> result<file-transition, plugin-error>;
}

world plugin {
  import host;
  export api;
}
