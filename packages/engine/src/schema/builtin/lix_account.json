{
  "x-lix-key": "lix_account",
  "x-lix-primary-key": [
    "/id"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "x-lix-default": "lix_uuid_v7()"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["human", "agent", "service", "system", "anonymous"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled"]
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "status"
  ],
  "additionalProperties": false
}
