{
	"name": "@lix-js/sdk",
	"type": "module",
	"version": "0.20.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/opral/lix"
	},
	"exports": {
		"./compatibility": {
			"types": "./dist/compatibility.d.ts",
			"default": "./dist/compatibility.js"
		},
		"./migration": {
			"types": "./dist/migration.d.ts",
			"default": "./dist/migration.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./storage-runtime": {
			"types": "./dist/storage-runtime.d.ts",
			"default": "./dist/storage-runtime.js"
		}
	},
	"imports": {
		"#binding": {
			"node": "./dist/binding.node.js",
			"default": "./dist/binding.browser.js"
		},
		"#worker-factory": {
			"node": "./dist/worker/factory.node.js",
			"default": "./dist/worker/factory.browser.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "npm run clean && npm run build:wasm && npm run build:ts",
		"build:browser": "npm run clean && npm run build:wasm && npm run build:ts",
		"build:wasm": "node ./scripts/build-wasm.js",
		"build:wasm:dev": "LIX_WASM_PROFILE=dev node ./scripts/build-wasm.js",
		"benchmark:plugin-reopen": "node ./scripts/benchmark-plugin-reopen.mjs",
		"benchmark:storage-boundary": "LIX_WASM_STORAGE_BENCH=1 npm run build:browser && LIX_WASM_STORAGE_BENCH=1 vitest run --config vitest.browser.config.ts src/storage-bridge.bench.browser.test.ts",
		"clean": "node ./scripts/clean.js",
		"build:ts": "node ./scripts/build-compatibility.js && tsc -p tsconfig.json",
		"test": "npm run build && vitest run",
		"test:browser": "npm run build:browser && vitest run --config vitest.browser.config.ts",
		"test:browser:built": "vitest run --config vitest.browser.config.ts",
		"test:native:production": "node ./scripts/test-packed-native-open.js",
		"test:browser:production": "node ./scripts/test-packed-vite.js",
		"typecheck": "node ./scripts/build-compatibility.js && tsc -p tsconfig.test.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.10.2",
		"@vitest/browser-playwright": "4.1.10",
		"playwright": "1.57.0",
		"typescript": "^5.5.4",
		"vite": "8.1.4",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@bytecodealliance/jco-transpile": "0.13.0",
		"binaryen": "130.0.0",
		"fflate": "^0.8.3"
	}
}
