{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "js",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["js/index.ts"],
	"exclude": ["dist", "node_modules"]
}
